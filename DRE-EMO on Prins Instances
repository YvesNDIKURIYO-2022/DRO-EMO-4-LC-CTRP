# ============================================================================
# PPO AGENT
# ============================================================================
class PPOAgent:
    def __init__(self, sd, ad, cfg):
        self.sd = sd; self.ad = ad
        self.pw = np.random.randn(sd, ad) * 0.01
        self.vw = np.random.randn(sd, 1) * 0.01
        self.opw = self.pw.copy()
        self.lr = cfg.ppo_learning_rate
        self.ce = cfg.ppo_clip_epsilon
        self.ga = cfg.ppo_gamma; self.gl = cfg.ppo_gae_lambda

    def get_action(self, s, bf=0.0, ew=None):
        if s.ndim > 1: s = s.flatten()
        s = np.pad(s, (0, max(0, self.sd - len(s))))[:self.sd]
        lg = s @ self.pw
        if ew is not None and bf > 0:
            ew = np.pad(ew, (0, max(0, len(lg) - len(ew))))[:len(lg)]
            lg = lg - bf * ew
        p = self._sm(lg); p = np.nan_to_num(p, nan=1.0 / self.ad)
        p = p / max(p.sum(), 1e-10)
        a = np.random.choice(self.ad, p=p); return a, p[a]

    def update(self, S, A, R, NS, D):
        if S.ndim == 1: S = S.reshape(1, -1)
        if NS.ndim == 1: NS = NS.reshape(1, -1)
        if S.shape[1] < self.sd:
            pad = ((0, 0), (0, self.sd - S.shape[1]))
            S = np.pad(S, pad); NS = np.pad(NS, pad)
        else:
            S = S[:, :self.sd]; NS = NS[:, :self.sd]
        aoh = np.zeros((len(A), self.ad)); aoh[np.arange(len(A)), A] = 1
        v = S @ self.vw; nv = NS @ self.vw
        dl = R + self.ga * (1 - D) * nv.flatten() - v.flatten()
        dl = np.nan_to_num(dl, nan=0.0)
        adv = np.zeros_like(dl); a = 0
        for t in reversed(range(len(dl))):
            a = dl[t] + self.ga * self.gl * (1 - D[t]) * a; adv[t] = a
        if len(adv) > 1 and np.std(adv) > 1e-8:
            adv = (adv - adv.mean()) / adv.std()
        op = self._sm(S @ self.opw); oa = op[np.arange(len(A)), A] + 1e-8
        np_ = self._sm(S @ self.pw); na = np_[np.arange(len(A)), A] + 1e-8
        ratio = np.nan_to_num(na / oa, nan=1.0, posinf=1 + self.ce, neginf=1 - self.ce)
        cl = np.clip(ratio, 1 - self.ce, 1 + self.ce)
        obj = np.minimum(ratio * adv, cl * adv)
        g = S.T @ ((obj[:, None] * (aoh - np_)) / np_)
        self.pw += self.lr * np.nan_to_num(g, nan=0.0)
        td = R + self.ga * (1 - D) * (NS @ self.vw).flatten() - v.flatten()
        self.vw += self.lr * S.T @ np.nan_to_num(td, nan=0.0)[:, None]
        self.opw = self.pw.copy()
        return float(np.mean(obj)) if len(obj) else 0.0

    def _sm(self, x):
        x = np.nan_to_num(x, nan=0.0, posinf=100.0, neginf=-100.0)
        e = np.exp(x - np.max(x, axis=-1, keepdims=True))
        return e / np.maximum(np.sum(e, axis=-1, keepdims=True), 1e-10)


# ============================================================================
# SHARED MOEA UTILITIES
# ============================================================================
def _dominates(a, b):
    one = False
    for ai, bi in zip(a, b):
        if ai > bi: return False
        if ai < bi: one = True
    return one


def non_dominated_sort(fit):
    n = len(fit)
    if n == 0: return []
    dom = [set() for _ in range(n)]; dc = [0] * n
    for i in range(n):
        for j in range(i + 1, n):
            if _dominates(fit[i], fit[j]): dom[i].add(j); dc[j] += 1
            elif _dominates(fit[j], fit[i]): dom[j].add(i); dc[i] += 1
    front = [i for i in range(n) if dc[i] == 0]
    fronts = [list(front)]
    while front:
        nxt = []
        for i in front:
            for j in dom[i]:
                dc[j] -= 1
                if dc[j] == 0: nxt.append(j)
        front = nxt
        if front: fronts.append(list(front))
    return fronts


def crowding_distance(fit, idx):
    m = len(fit[0]); n = len(idx)
    if n == 0: return np.array([])
    if n <= 2: return np.full(n, np.inf)
    d = np.zeros(n)
    for k in range(m):
        vals = np.array([fit[i][k] for i in idx])
        order = np.argsort(vals)
        d[order[0]] = np.inf; d[order[-1]] = np.inf
        rng = vals[order[-1]] - vals[order[0]]
        if rng <= 1e-12: continue
        for i in range(1, n - 1):
            d[order[i]] += (vals[order[i + 1]] - vals[order[i - 1]]) / rng
    return d


# ============================================================================
# DRO-EMO
# ============================================================================
class DROEMO:
    name = 'dro_emo'
    _CACHE_MAX = 50000

    def __init__(self, problem, cfg):
        self.problem = problem; self.cfg = cfg
        self.pop_size = cfg.get_population(problem.n_var)
        self.max_gen = cfg.get_generations(problem.n_var)
        self.n_var = problem.n_var; self.n_obj = problem.n_obj
        sd = min(self.n_var + 4, 50); ad = min(self.n_var * 3, 100)
        self.ppo = PPOAgent(sd, ad, cfg)
        if cfg.use_ppo_init: self._pretrain()
        self.population = []; self.fitness = []
        self.archive = []; self.history = {'hypervolume': [], 'diversity': []}
        self._last_reset = -9999
        self._eval_cache: Dict[bytes, Tuple[float, float, float]] = {}

    def _pretrain(self):
        for _ in range(min(20, self.cfg.ppo_training_episodes // 10)):
            bs = 5
            s = np.random.randn(bs, self.ppo.sd)
            a = np.random.randint(0, self.ppo.ad, bs)
            r = np.random.randn(bs); ns = np.random.randn(bs, self.ppo.sd)
            self.ppo.update(s, a, r, ns, np.zeros(bs))

    def _enc(self, x):
        s = np.zeros(self.ppo.sd); n = min(len(x), self.ppo.sd - 4)
        s[:n] = x[:n] / 10.0; return s

    def init_pop(self):
        if not self.cfg.use_ppo_init:
            return [np.random.uniform(0, 1, self.n_var) for _ in range(self.pop_size)]
        pop = []
        n_ppo = max(1, int(self.pop_size * self.cfg.ppo_proportion))
        n_h = max(1, int(self.pop_size * self.cfg.heuristic_proportion))
        n_r = max(1, int(self.pop_size * self.cfg.random_proportion))
        for _ in range(n_ppo):
            seed = np.random.uniform(0, 1, self.n_var)
            a, _ = self.ppo.get_action(self._enc(seed), bf=0.3)
            guided = seed.copy()
            if self.n_var > 0:
                guided[a % self.n_var] = np.clip(guided[a % self.n_var] + 0.3, 0.0, 1.0)
            pop.append(guided)
        for _ in range(n_h):
            x = np.random.uniform(0, 1, self.n_var)
            no = max(1, self.problem.n_depots // 2)
            nd = self.problem.n_depots
            if nd > 0:
                caps = self.problem._depot_caps
                top = np.argsort(caps)[::-1][:no]
                x[:nd] = 0.0; x[top] = 1.0
            pop.append(x)
        for _ in range(n_r):
            pop.append(np.random.uniform(0, 1, self.n_var))
        while len(pop) < self.pop_size:
            pop.append(1.0 - np.random.uniform(0, 1, self.n_var))
        return pop[:self.pop_size]

    def evaluate(self, x):
        key = np.asarray(x, dtype=float).tobytes()
        cached = self._eval_cache.get(key)
        if cached is not None: return cached
        try:
            if self.cfg.use_dro_bound:
                val = self.problem.evaluate(x)
            else:
                val = self.problem.evaluate_deterministic(x)
        except Exception:
            val = (1e10, 1e10, 1e10)
        if len(self._eval_cache) >= self._CACHE_MAX: self._eval_cache.clear()
        self._eval_cache[key] = val
        return val

    def _crowd(self, front, fit=None):
        n = len(front)
        if n <= 2: return [float('inf')] * n
        if fit is None: fit = [self.evaluate(s) for s in front]
        d = [0.0] * n; m = len(fit[0])
        for k in range(m):
            order = sorted(range(n), key=lambda i: fit[i][k])
            d[order[0]] = float('inf'); d[order[-1]] = float('inf')
            lo, hi = fit[order[0]][k], fit[order[-1]][k]
            rng = hi - lo if hi > lo else 1.0
            for i in range(1, n - 1):
                d[order[i]] += (fit[order[i + 1]][k] - fit[order[i - 1]][k]) / rng
        return d

    def _div(self, pop):
        if not pop: return 0.0
        return len(set(tuple(np.round(p, 6)) for p in pop)) / len(pop)

    def _conv_state(self, pop):
        if not pop: return 0.0
        fit = [self.evaluate(p) for p in pop]; m = len(fit[0]); tot = 0.0
        for k in range(m):
            vals = [f[k] for f in fit if np.isfinite(f[k])]
            if not vals: continue
            lo, hi = min(vals), max(vals); rng = hi - lo if hi > lo else 1.0
            tot += np.mean([(v - lo) / rng for v in vals])
        return float(tot / m) if np.isfinite(tot) else 0.0

    def _ops(self, gen):
        if not self.cfg.use_adaptive_operators:
            return (self.cfg.exploitation_base, self.cfg.exploration_base)
        g, G = gen, max(1, self.max_gen)
        conv = self._conv_state(self.population)
        div = self._div(self.population)
        fb = max(0.5, min(1.5, 1.0 + div - conv))
        return (max(0.5, min(0.95, self.cfg.exploitation_base * (1 - np.exp(-g / G)) * fb)),
                max(0.02, min(0.3, self.cfg.exploration_base * np.exp(-g / G) / fb)))

    def _upd_arc(self):
        mx = int(self.cfg.archive_size_ratio * self.pop_size)
        fronts = non_dominated_sort(self.fitness)
        if not fronts: return
        for i in fronts[0]:
            s = self.population[i]
            if len(self.archive) < mx: self.archive.append(s)
            else:
                d = self._crowd(self.archive)
                k = int(np.argmin(d))
                if d[k] < float('inf'): self.archive[k] = s

    def _reset_arc(self, gen):
        if not self.archive: return
        if gen - self._last_reset < self.cfg.diversity_reset_min_interval: return
        n = min(int(self.cfg.diversity_reset_proportion * self.pop_size), len(self.archive))
        if n == 0: return
        sums = [sum(f) for f in self.fitness]
        worst = sorted(range(len(self.population)), key=lambda i: sums[i], reverse=True)
        idxs = np.random.choice(len(self.archive), n, replace=False)
        for i, a in enumerate(idxs):
            if i < len(worst):
                self.population[worst[i]] = self.archive[a].copy()
                self.fitness[worst[i]] = self.evaluate(self.archive[a])
        self._last_reset = gen

    def _sbx(self, p1, p2, rate):
        if np.random.random() > rate: return p1.copy()
        c = p1.copy(); mask = np.random.random(len(p1)) < 0.5
        c[mask] = p2[mask]; return c

    def _mut(self, x, rate):
        m = x.copy(); mask = np.random.random(len(x)) < rate
        m[mask] += np.random.normal(0, 0.1, size=mask.sum())
        return np.clip(m, 0, 1)

    def _tourn(self, k):
        sel = []
        for _ in range(k):
            i, j = np.random.choice(len(self.population), 2, replace=False)
            f0, f1 = self.fitness[i], self.fitness[j]
            if _dominates(f0, f1): sel.append(self.population[i])
            elif _dominates(f1, f0): sel.append(self.population[j])
            else: sel.append(self.population[i])
        return sel

    def _ls(self, x, n=None):
        n = n or self.cfg.local_search_iterations
        eps = float(getattr(self.cfg, 'local_search_epsilon', 0.0))
        best = x.copy(); bf = self.evaluate(best)
        for it in range(n):
            c = best.copy()
            if it < n // 2:
                i, j = np.random.choice(len(c), 2, replace=False)
                c[i], c[j] = c[j], c[i]
            else:
                nd = self.problem.n_depots
                if self.n_var >= 2:
                    i, j = sorted(np.random.choice(self.n_var, 2, replace=False))
                    seg = c[nd + i: nd + j + 1].copy()
                    c[nd + i: nd + j + 1] = seg[::-1]
            cf = self.evaluate(c)
            if eps > 0.0:
                if _epsilon_dominates(cf, bf, eps):
                    best, bf = c, cf
            else:
                if _dominates(cf, bf):
                    best, bf = c, cf
        return best

    def run(self):
        self.population = self.init_pop()
        self.fitness = [self.evaluate(p) for p in self.population]
        fronts = non_dominated_sort(self.fitness)
        if fronts:
            self.archive = [self.population[i]
                            for i in fronts[0][:int(self.cfg.archive_size_ratio * self.pop_size)]]
        stride = max(1, int(self.cfg.hv_stride))
        for gen in range(self.max_gen):
            div = self._div(self.population)
            p_c, p_m = self._ops(gen)
            off = []
            while len(off) < self.pop_size:
                p1, p2 = self._tourn(2)
                c = self._sbx(p1, p2, p_c); c = self._mut(c, p_m); off.append(c)
            off_fit = [self.evaluate(c) for c in off]
            comb = self.population + off; comb_fit = self.fitness + off_fit
            fronts = non_dominated_sort(comb_fit)
            np_, nf = [], []
            for fr in fronts:
                if len(np_) + len(fr) <= self.pop_size:
                    for i in fr: np_.append(comb[i]); nf.append(comb_fit[i])
                else:
                    d = crowding_distance(comb_fit, fr)
                    order = np.argsort(-d)
                    rem = self.pop_size - len(np_)
                    for i in order[:rem]:
                        np_.append(comb[fr[i]]); nf.append(comb_fit[fr[i]])
                    break
            self.population, self.fitness = np_, nf
            self._upd_arc()
            if div < self.cfg.diversity_reset_threshold:
                self._reset_arc(gen)
            if (self.cfg.use_local_search
                    and gen % self.cfg.local_search_frequency == 0):
                nt = max(1, int(self.pop_size * self.cfg.local_search_top_proportion))
                top = sorted(range(len(self.population)), key=lambda i: sum(self.fitness[i]))[:nt]
                for i in top:
                    im = self._ls(self.population[i])
                    self.population[i] = im; self.fitness[i] = self.evaluate(im)
            if (gen % stride == 0) or (gen == self.max_gen - 1):
                hv = _compute_hv(np.array(self.fitness))
                self.history['hypervolume'].append(hv)
            self.history['diversity'].append(div)
        fronts = non_dominated_sort(self.fitness)
        idx = fronts[0] if fronts else []
        pareto = [self.population[i] for i in idx]
        pareto_fit = [self.fitness[i] for i in idx]
        return {'population': pareto, 'fitness': pareto_fit,
                'history': self.history, 'hypervolume': 0.0}


def _epsilon_dominates(a, b, eps):
    strictly_better = False
    for ai, bi in zip(a, b):
        if ai > bi + eps: return False
        if ai < bi - eps: strictly_better = True
    return strictly_better


# ============================================================================
# COMPETITORS
# ============================================================================
class NSGAII:
    name = 'nsga2'

    def __init__(self, problem, config):
        self.problem = problem
        self.pop_size = 100; self.max_gen = 100
        self.n_var = problem.n_var
        self.eta_c = 20.0; self.eta_m = 20.0
        self.p_c = 0.9; self.p_m = 1.0 / max(self.n_var, 1)

    def run(self):
        pop = [np.random.uniform(0, 1, self.n_var) for _ in range(self.pop_size)]
        fit = [self.problem.evaluate(p) for p in pop]
        for _ in range(self.max_gen):
            off = []
            while len(off) < self.pop_size:
                p1 = self._t(pop, fit); p2 = self._t(pop, fit)
                c1, c2 = self._sbx(p1, p2)
                off.append(self._mut(c1))
                if len(off) < self.pop_size: off.append(self._mut(c2))
            off_fit = [self.problem.evaluate(o) for o in off]
            pop, fit = self._env(pop + off, fit + off_fit, self.pop_size)
        fr = non_dominated_sort(fit); idx = fr[0] if fr else []
        return {'population': [pop[i] for i in idx], 'fitness': [fit[i] for i in idx],
                'history': {'hypervolume': []}, 'hypervolume': 0.0}

    def _t(self, pop, fit, k=2):
        idx = np.random.choice(len(pop), k, replace=False); b = idx[0]
        for i in idx[1:]:
            if _dominates(fit[i], fit[b]): b = i
        return pop[b]

    def _sbx(self, p1, p2):
        if np.random.random() > self.p_c: return p1.copy(), p2.copy()
        c1, c2 = p1.copy(), p2.copy()
        for i in range(self.n_var):
            if np.random.random() <= 0.5 and abs(p1[i] - p2[i]) > 1e-14:
                y1, y2 = (p1[i], p2[i]) if p1[i] < p2[i] else (p2[i], p1[i])
                yl, yu = 0.0, 1.0; r = np.random.random()
                b = 1.0 + (2.0 * (y1 - yl) / (y2 - y1 + 1e-14))
                a = 2.0 - b ** (-(self.eta_c + 1.0))
                bq = (r * a) ** (1.0 / (self.eta_c + 1.0)) if r <= 1.0 / a else (1.0 / (2.0 - r * a)) ** (1.0 / (self.eta_c + 1.0))
                c1i = 0.5 * ((y1 + y2) - bq * (y2 - y1))
                b = 1.0 + (2.0 * (yu - y2) / (y2 - y1 + 1e-14))
                a = 2.0 - b ** (-(self.eta_c + 1.0))
                bq = (r * a) ** (1.0 / (self.eta_c + 1.0)) if r <= 1.0 / a else (1.0 / (2.0 - r * a)) ** (1.0 / (self.eta_c + 1.0))
                c2i = 0.5 * ((y1 + y2) + bq * (y2 - y1))
                c1i = np.clip(c1i, yl, yu); c2i = np.clip(c2i, yl, yu)
                if np.random.random() <= 0.5: c1[i], c2[i] = c1i, c2i
                else: c1[i], c2[i] = c2i, c1i
        return c1, c2

    def _mut(self, x):
        y = x.copy(); yl, yu = 0.0, 1.0
        d1 = (y - yl) / (yu - yl + 1e-14); d2 = (yu - y) / (yu - yl + 1e-14)
        for i in range(self.n_var):
            if np.random.random() <= self.p_m:
                r = np.random.random(); mp = 1.0 / (self.eta_m + 1.0)
                if r <= 0.5:
                    xy = 1 - d1[i]; v = 2 * r + (1 - 2 * r) * (xy ** (self.eta_m + 1)); dq = v ** mp - 1
                else:
                    xy = 1 - d2[i]; v = 2 * (1 - r) + 2 * (r - 0.5) * (xy ** (self.eta_m + 1)); dq = 1 - v ** mp
                y[i] = np.clip(y[i] + dq * (yu - yl), yl, yu)
        return y

    def _env(self, pop, fit, k):
        fr = non_dominated_sort(fit); np_, nf = [], []
        for f in fr:
            if len(np_) + len(f) <= k:
                for i in f: np_.append(pop[i]); nf.append(fit[i])
            else:
                d = crowding_distance(fit, f)
                order = np.argsort(-d)
                rem = k - len(np_)
                for i in order[:rem]: np_.append(pop[f[i]]); nf.append(fit[f[i]])
                break
        return np_, nf


class NSGAIII(NSGAII):
    name = 'nsga3'

    def __init__(self, problem, config):
        super().__init__(problem, config)
        self.ref = self._dirs()

    def _dirs(self, p=12):
        m = self.problem.n_obj; d = []
        for c in combinations_with_replacement(range(p + 1), m):
            if sum(c) == p: d.append([x / p for x in c])
        d = np.array(d)
        if len(d) > self.pop_size:
            idx = np.random.choice(len(d), self.pop_size, replace=False)
            d = d[idx]
        return d

    def _assoc(self, F, ideal):
        F = np.array(F); Ft = F - ideal
        fm = np.abs(Ft).max(axis=0); fm[fm < 1e-12] = 1.0
        Fn = Ft / fm
        R = self.ref / np.maximum(np.linalg.norm(self.ref, axis=1, keepdims=True), 1e-12)
        D = np.zeros((len(Fn), len(R)))
        for i, f in enumerate(Fn):
            p = f @ R.T; pp = p[:, None] * R
            D[i] = np.linalg.norm(f[None, :] - pp, axis=1)
        return np.argmin(D, axis=1)

    def _env(self, pop, fit, k):
        fr = non_dominated_sort(fit); np_, nf = [], []
        for f in fr:
            if len(np_) + len(f) <= k:
                for i in f: np_.append(pop[i]); nf.append(fit[i])
            else:
                ideal = np.min(np.array(nf if nf else fit), axis=0)
                la = [fit[i] for i in f]
                assoc = self._assoc(la, ideal)
                if nf:
                    an = self._assoc(nf, ideal)
                    nc = np.bincount(an, minlength=len(self.ref))
                else:
                    nc = np.zeros(len(self.ref), dtype=int)
                rem = k - len(np_); avail = list(range(len(f)))
                while rem > 0 and avail:
                    dw = [d for d in range(len(self.ref)) if d in assoc[avail]]
                    if not dw: break
                    mn = min(nc[d] for d in dw)
                    cd = np.random.choice([d for d in dw if nc[d] == mn])
                    ind = [i for i in avail if assoc[i] == cd]
                    if not ind: break
                    p = np.random.choice(ind)
                    np_.append(pop[f[p]]); nf.append(fit[f[p]]); nc[cd] += 1
                    avail.remove(p); rem -= 1
                if rem > 0:
                    sub_fit = [fit[f[i]] for i in avail]
                    sub_idx = list(range(len(avail)))
                    d = crowding_distance(sub_fit, sub_idx)
                    for i in np.argsort(-d)[:rem]:
                        np_.append(pop[f[avail[i]]]); nf.append(fit[f[avail[i]]])
                break
        return np_, nf


class SPEA2(NSGAII):
    name = 'spea2'

    def __init__(self, problem, config):
        super().__init__(problem, config)
        self.arc_size = self.pop_size

    def _sf(self, pop, fit):
        n = len(fit)
        if n == 0: return np.zeros(0)
        F = np.array(fit, dtype=float)
        less_equal = (F[None, :, :] >= F[:, None, :]).all(axis=-1)
        strictly_less = (F[None, :, :] > F[:, None, :]).any(axis=-1)
        dominates = less_equal & strictly_less
        np.fill_diagonal(dominates, False)
        strength = dominates.sum(axis=0)
        raw = (dominates * strength[None, :]).sum(axis=1)
        Fmin = F.min(axis=0); Fmax = F.max(axis=0)
        rng = Fmax - Fmin; rng[rng < 1e-12] = 1.0
        Fn = (F - Fmin) / rng
        D = distance.cdist(Fn, Fn); np.fill_diagonal(D, np.inf)
        k = int(np.sqrt(n))
        kth = np.sort(D, axis=1)[:, min(k, n - 2)]
        density = 1.0 / (kth + 2.0)
        return raw + density

    def _env(self, pop, fit, k):
        n = len(pop); sf = self._sf(pop, fit)
        nd = [i for i in range(n) if sf[i] < 1.0]
        dom = [i for i in range(n) if sf[i] >= 1.0]
        if len(nd) <= k:
            sel = list(nd) + sorted(dom, key=lambda i: sf[i])[:k - len(nd)]
        else:
            sel = list(nd); F = np.array([fit[i] for i in sel])
            Fmin = F.min(0); Fmax = F.max(0)
            rng = Fmax - Fmin; rng[rng < 1e-12] = 1.0
            Fn = (F - Fmin) / rng
            while len(sel) > k:
                D = distance.cdist(Fn, Fn); np.fill_diagonal(D, np.inf)
                md = np.sort(D, axis=1)[:, 0]
                rm = int(np.argmin(md)); sel.pop(rm); Fn = np.delete(Fn, rm, axis=0)
        return [pop[i] for i in sel], [fit[i] for i in sel]

    def run(self):
        pop = [np.random.uniform(0, 1, self.n_var) for _ in range(self.pop_size)]
        fit = [self.problem.evaluate(p) for p in pop]
        arc, af = [], []
        for _ in range(self.max_gen):
            u = pop + arc; uf = fit + af
            off = []
            while len(off) < self.pop_size:
                p1 = self._t(u, uf); p2 = self._t(u, uf)
                c1, c2 = self._sbx(p1, p2)
                off.append(self._mut(c1))
                if len(off) < self.pop_size: off.append(self._mut(c2))
            of = [self.problem.evaluate(o) for o in off]
            u = pop + arc + off; uf = fit + af + of
            pop, fit = self._env(u, uf, self.arc_size)
            arc, af = pop, fit
        fr = non_dominated_sort(fit); idx = fr[0] if fr else []
        return {'population': [pop[i] for i in idx], 'fitness': [fit[i] for i in idx],
                'history': {'hypervolume': []}, 'hypervolume': 0.0}


class MOEAD(NSGAII):
    name = 'moead'

    def __init__(self, problem, config):
        super().__init__(problem, config)
        self.T = max(2, int(0.2 * self.pop_size)); self.nr = 2
        self.W = self._weights()
        D = distance.cdist(self.W, self.W)
        self.nb = np.argsort(D, axis=1)[:, :self.T]

    def _weights(self):
        m = self.problem.n_obj; N = self.pop_size
        if m == 3:
            p = 1
            while True:
                d = [[x / p for x in c]
                     for c in combinations_with_replacement(range(p + 1), m)
                     if sum(c) == p]
                if len(d) >= N: break
                p += 1
            d = np.array(d)
            if len(d) > N:
                d = d[np.random.choice(len(d), N, replace=False)]
            return d
        return np.random.dirichlet(np.ones(m), N)

    def _tch(self, f, w, z):
        return float(np.max(w * np.abs(np.array(f) - z)))

    def run(self):
        pop = [np.random.uniform(0, 1, self.n_var) for _ in range(self.pop_size)]
        fit = [self.problem.evaluate(p) for p in pop]
        z = np.min(np.array(fit), 0)
        for _ in range(self.max_gen):
            for i in range(self.pop_size):
                k, l = np.random.choice(self.nb[i], 2, replace=False)
                c = pop[i] + 0.5 * (pop[k] - pop[l])
                c = np.clip(c, 0, 1) if np.random.random() < 0.5 else pop[i].copy()
                c = self._mut(c); cf = self.problem.evaluate(c)
                z = np.minimum(z, np.array(cf))
                rep = 0
                for j_idx in np.random.permutation(self.T):
                    j = self.nb[i][j_idx]
                    if self._tch(cf, self.W[j], z) < self._tch(fit[j], self.W[j], z):
                        pop[j] = c.copy(); fit[j] = cf; rep += 1
                        if rep >= self.nr: break
        fr = non_dominated_sort(fit); idx = fr[0] if fr else []
        return {'population': [pop[i] for i in idx], 'fitness': [fit[i] for i in idx],
                'history': {'hypervolume': []}, 'hypervolume': 0.0}


class RLNSGAII(NSGAII):
    name = 'rl_nsgaii'

    def __init__(self, problem, config):
        super().__init__(problem, config)
        self.q = np.zeros((5, 5))
        self.params = [(0.9, 0.1), (0.8, 0.2), (0.7, 0.3), (0.6, 0.4), (0.5, 0.5)]

    def _state(self, pop):
        u = len(set(tuple(np.round(s, 4)) for s in pop))
        return float(np.clip(u / max(1, len(pop)), 0, 1))

    def run(self):
        pop = [np.random.uniform(0, 1, self.n_var) for _ in range(self.pop_size)]
        fit = [self.problem.evaluate(p) for p in pop]
        for _ in range(self.max_gen):
            s = int(np.clip(self._state(pop) * 5, 0, 4))
            a = (np.random.randint(0, len(self.params))
                 if np.random.random() < 0.1 else int(np.argmax(self.q[s])))
            self.p_c, self.p_m = self.params[a]
            off = []
            while len(off) < self.pop_size:
                p1 = self._t(pop, fit); p2 = self._t(pop, fit)
                c1, c2 = self._sbx(p1, p2)
                off.append(self._mut(c1))
                if len(off) < self.pop_size: off.append(self._mut(c2))
            of = [self.problem.evaluate(o) for o in off]
            pop, fit = self._env(pop + off, fit + of, self.pop_size)
            r = -float(np.mean([sum(f) for f in fit])) if fit else -1e6
            ns = int(np.clip(self._state(pop) * 5, 0, 4))
            self.q[s, a] += 0.1 * (r + 0.9 * np.max(self.q[ns]) - self.q[s, a])
        fr = non_dominated_sort(fit); idx = fr[0] if fr else []
        return {'population': [pop[i] for i in idx], 'fitness': [fit[i] for i in idx],
                'history': {'hypervolume': []}, 'hypervolume': 0.0}


