def _compute_hv(fit, ref=None, lo=None, n_samples=3000):
    try:
        F = np.asarray(fit, dtype=float)
        F = F[np.all(np.isfinite(F) & (np.abs(F) < 1e12), axis=1)]
        if len(F) == 0: return 0.0
        m = F.shape[1]
        if ref is None or lo is None:
            ref = np.where(F.max(0) * 1.1 > 1e-9, F.max(0) * 1.1, 1.0)
            lo = F.min(0)
        ref = np.asarray(ref, dtype=float).flatten()[:m]
        lo = np.asarray(lo, dtype=float).flatten()[:m]
        span = ref - lo; span[span < 1e-12] = 1.0
        Fn = (F - lo) / span
        le = (Fn[None, :, :] >= Fn[:, None, :]).all(axis=-1)
        sl = (Fn[None, :, :] > Fn[:, None, :]).any(axis=-1)
        dom = le & sl
        np.fill_diagonal(dom, False)
        nd = Fn[~dom.any(axis=1)]
        if len(nd) == 0: return 0.0
        rng = np.random.default_rng(0)
        pts = rng.uniform(0.0, 1.0, (n_samples, m))
        inside = (pts[:, None, :] >= nd[None, :, :]).all(axis=2).any(axis=1)
        return float(inside.mean())
    except Exception:
        return 0.0


def compute_metrics_3obj(pareto_fit, ref=None, lo=None):
    if pareto_fit is None or len(pareto_fit) == 0:
        return {'hypervolume': 0.0, 'spacing': 0.0, 'cardinality': 0,
                'best_cost': float('inf'), 'best_emission': float('inf'),
                'best_time': float('inf')}
    F = np.asarray(pareto_fit, dtype=float)
    F = F[np.all(np.isfinite(F) & (np.abs(F) < 1e12), axis=1)]
    if len(F) == 0:
        return {'hypervolume': 0.0, 'spacing': 0.0, 'cardinality': 0,
                'best_cost': float('inf'), 'best_emission': float('inf'),
                'best_time': float('inf')}
    hv = _compute_hv(F, ref=ref, lo=lo, n_samples=10000)
    if len(F) > 1:
        d = distance.cdist(F, F); np.fill_diagonal(d, np.inf)
        md = d.min(axis=1); sp = float(np.std(md) / max(np.mean(md), 1e-10))
    else:
        sp = 0.0
    return {'hypervolume': float(hv), 'spacing': sp, 'cardinality': int(len(F)),
            'best_cost': float(F[:, 0].min()),
            'best_emission': float(F[:, 1].min()),
            'best_time': float(F[:, 2].min())}


def summary_stats(data):
    if not data:
        return {'mean': 0, 'std': 0, 'median': 0, 'min': 0, 'max': 0,
                'cv': 0, 'n': 0, 'ci95_low': 0, 'ci95_high': 0}
    v = [x for x in data if np.isfinite(x)]
    if not v:
        return {'mean': 0, 'std': 0, 'median': 0, 'min': 0, 'max': 0,
                'cv': 0, 'n': 0, 'ci95_low': 0, 'ci95_high': 0}
    m = float(np.mean(v)); s = float(np.std(v, ddof=1)) if len(v) > 1 else 0.0
    return {'mean': m, 'std': s, 'median': float(np.median(v)),
            'min': float(np.min(v)), 'max': float(np.max(v)),
            'cv': float(s / m) if m != 0 else 0.0, 'n': len(v),
            'ci95_low': float(m - 1.96 * s / np.sqrt(len(v))) if len(v) > 1 else m,
            'ci95_high': float(m + 1.96 * s / np.sqrt(len(v))) if len(v) > 1 else m}


def cohens_d(a, b):
    a = [x for x in a if np.isfinite(x)]; b = [x for x in b if np.isfinite(x)]
    if len(a) < 2 or len(b) < 2: return 0.0
    md = np.mean(a) - np.mean(b)
    va = np.var(a, ddof=1); vb = np.var(b, ddof=1)
    p = np.sqrt(((len(a) - 1) * va + (len(b) - 1) * vb) / (len(a) + len(b) - 2))
    return float(md / p) if p > 0 else 0.0


def interpret_d(d):
    ad = abs(d)
    if ad < 0.2: return "negligible"
    if ad < 0.5: return "small"
    if ad < 0.8: return "medium"
    return "large"


def cliffs_delta(a, b):
    a = np.asarray([x for x in a if np.isfinite(x)], dtype=float)
    b = np.asarray([x for x in b if np.isfinite(x)], dtype=float)
    if len(a) == 0 or len(b) == 0: return 0.0
    gt = (a[:, None] > b[None, :]).sum()
    lt = (a[:, None] < b[None, :]).sum()
    return float((gt - lt) / (len(a) * len(b)))


