def _parse_args():
    parser = argparse.ArgumentParser(description="DRO-EMO Prins benchmark")
    parser.add_argument("--smoke", action="store_true")
    parser.add_argument("--runs", type=int, default=30)
    args, unknown = parser.parse_known_args()
    if unknown:
        in_notebook = 'ipykernel' in sys.modules or 'IPython' in sys.modules
        if not in_notebook:
            print(f"[args] Ignoring unrecognized arguments: {unknown}", flush=True)
    return args


def main():
    args = _parse_args()
    print("=" * 90, flush=True)
    print("DRO-EMO: Prins Routing Benchmark (PART A)", flush=True)
    print("=" * 90, flush=True)
    if not os.path.isfile(INPUT_EXCEL):
        print("\nERROR: Input Excel file not found.", flush=True); return

    print("\nLoading instances...", flush=True)
    instances = load_prins_instances(INPUT_EXCEL)
    print(f"Loaded {len(instances)} instances.", flush=True)
    if not instances:
        print("\nERROR: No usable instances.", flush=True); return

    config = ExperimentConfig()
    if args.smoke:
        names = ['20-5-1a', '50-5-2ab', '100-5-1ab']
        instances = [i for i in instances if i.name in names]
        config.num_runs = 5
        print(f"\n[smoke] {len(instances)} instances × {config.num_runs} runs",
              flush=True)
    else:
        config.num_runs = args.runs
        print(f"\n[full] {len(instances)} instances × {config.num_runs} runs",
              flush=True)

    algorithms = ['dro_emo', 'nsga2', 'nsga3', 'spea2', 'moead', 'rl_nsgaii']
    runner = BenchmarkRunner(config)

    log("\n" + "#" * 70)
    log("# PART A — MAIN BENCHMARK")
    log("#" * 70)
    t_start = time.time()
    try:
        runner.run_all(instances, algorithms)
    except KeyboardInterrupt:
        print("\n[interrupted] Saving partial results...", flush=True)

    print("\n" + "=" * 60, flush=True)
    print("Statistical analysis", flush=True)
    print("=" * 60, flush=True)
    try:
        stats_report = runner.statistical_analysis(reference_alg='dro_emo')
    except Exception as e:
        print(f"[warn] statistical analysis failed: {e}", flush=True)
        stats_report = {}

    os.makedirs(OUTPUT_BASE_DIR, exist_ok=True)
    runner.generate_report(OUTPUT_BASE_DIR, stats_report)

    elapsed = time.time() - t_start
    print("\n" + "=" * 90, flush=True)
    print(f"COMPLETED in {elapsed/60:.1f} minutes", flush=True)
    print("=" * 90, flush=True)
    print(f"Output: {OUTPUT_BASE_DIR}", flush=True)


if __name__ == "__main__":
    main()
