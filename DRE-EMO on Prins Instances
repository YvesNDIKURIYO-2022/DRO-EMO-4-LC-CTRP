class BenchmarkRunner:
    def __init__(self, config):
        self.config = config
        self.results = {}
        self.fronts = {}
        self.all_metrics = {}
        self.all_det_metrics = {}
        self.instances_loaded: List[PrinsInstance] = []
        np.random.seed(config.base_seed)
        random.seed(config.base_seed)

    def get_algorithm(self, name, problem):
        name = name.lower()
        if name == 'dro_emo': return DROEMO(problem, self.config.dro_emo)
        if name == 'nsga2': return NSGAII(problem, self.config)
        if name == 'nsga3': return NSGAIII(problem, self.config)
        if name == 'spea2': return SPEA2(problem, self.config)
        if name == 'moead': return MOEAD(problem, self.config)
        if name == 'rl_nsgaii': return RLNSGAII(problem, self.config)
        raise ValueError(f"Unknown algorithm: {name}")

    def run_instance(self, instance, algorithms, num_runs=None):
        num_runs = num_runs or self.config.num_runs
        problem = LCCLRP(instance)
        results, fronts = {}, {}
        metrics_by_alg, det_by_alg = {}, {}
        per_run_fronts = {alg: [] for alg in algorithms}
        per_run_det = {alg: [] for alg in algorithms}

        for alg in algorithms:
            log(f"    Running {alg} on {instance.name}...")
            alg_fronts = []; alg_det = []
            for run in range(num_runs):
                seed = self.config.get_seed(run)
                np.random.seed(seed); random.seed(seed)
                try:
                    algo = self.get_algorithm(alg, problem)
                    result = algo.run()
                except Exception as e:
                    log(f"      [warn] {alg} run {run} failed: {e}")
                    result = {'population': [], 'fitness': [], 'history': {}}
                pop = result.get('population', [])
                fit = (np.array(result['fitness'], dtype=float)
                       if result['fitness'] else np.array([]))
                det_fit = (np.array([problem.evaluate_deterministic(s) for s in pop])
                           if pop else np.array([]))
                alg_fronts.append(fit)
                if len(det_fit) > 0:
                    alg_det.append({
                        'det_best_cost': float(det_fit[:, 0].min()),
                        'det_best_emission': float(det_fit[:, 1].min()),
                        'det_best_time': float(det_fit[:, 2].min()),
                    })
                else:
                    alg_det.append({'det_best_cost': float('inf'),
                                    'det_best_emission': float('inf'),
                                    'det_best_time': float('inf')})
            per_run_fronts[alg] = alg_fronts
            per_run_det[alg] = alg_det

        all_fronts = []
        for alg in algorithms:
            for f in per_run_fronts[alg]:
                if f is not None and len(f) > 0: all_fronts.append(f)
        if all_fronts:
            pooled = np.vstack(all_fronts)
            pooled = pooled[np.all(np.isfinite(pooled) & (np.abs(pooled) < 1e12), axis=1)]
            if len(pooled) > 0:
                global_ref = np.where(pooled.max(0) * 1.1 > 1e-9,
                                      pooled.max(0) * 1.1, 1.0)
                global_lo = pooled.min(0)
            else:
                global_ref = None; global_lo = None
        else:
            global_ref = None; global_lo = None

        for alg in algorithms:
            alg_metrics = [compute_metrics_3obj(fit, ref=global_ref, lo=global_lo)
                           for fit in per_run_fronts[alg]]
            hvs = [m['hypervolume'] for m in alg_metrics]
            best = int(np.argmax(hvs)) if hvs else 0
            fronts[alg] = per_run_fronts[alg][best] if per_run_fronts[alg] else np.array([])
            metrics_by_alg[alg] = alg_metrics
            det_by_alg[alg] = per_run_det[alg]

        for alg in algorithms:
            alg_metrics = metrics_by_alg[alg]
            alg_det = det_by_alg[alg]
            results[alg] = {'summary': {
                'hypervolume': summary_stats([m['hypervolume'] for m in alg_metrics]),
                'spacing': summary_stats([m['spacing'] for m in alg_metrics]),
                'cardinality': summary_stats([m['cardinality'] for m in alg_metrics]),
                'best_cost': summary_stats([m['best_cost'] for m in alg_metrics]),
                'best_emission': summary_stats([m['best_emission'] for m in alg_metrics]),
                'best_time': summary_stats([m['best_time'] for m in alg_metrics]),
                'det_best_cost': summary_stats([m['det_best_cost'] for m in alg_det]),
                'det_best_emission': summary_stats([m['det_best_emission'] for m in alg_det]),
                'det_best_time': summary_stats([m['det_best_time'] for m in alg_det]),
            }}
            log(f"      HV(global ref): "
                f"{results[alg]['summary']['hypervolume']['mean']:.4f} "
                f"± {results[alg]['summary']['hypervolume']['std']:.4f}   "
                f"Det-cost: {results[alg]['summary']['det_best_cost']['mean']:.4g}   "
                f"Det-CO2: {results[alg]['summary']['det_best_emission']['mean']:.4g}")

        self.results[instance.name] = results
        self.fronts[instance.name] = fronts
        self.all_metrics[instance.name] = metrics_by_alg
        self.all_det_metrics[instance.name] = det_by_alg
        return results

    def run_all(self, instances, algorithms):
        self.instances_loaded = instances
        t0 = time.time()
        for idx, inst in enumerate(instances, 1):
            log(f"\n{'='*60}\nInstance {idx}/{len(instances)}: {inst.name} "
                f"(depots={inst.n_depots}, customers={inst.n_customers})  "
                f"[elapsed {time.time()-t0:.0f}s]\n{'='*60}")
            try:
                self.run_instance(inst, algorithms)
            except KeyboardInterrupt:
                log("  Interrupted by user — saving partial results.")
                raise
            except Exception as e:
                log(f"  ERROR on {inst.name}: {e}")
                import traceback; traceback.print_exc(); continue
        return self.results

    def statistical_analysis(self, reference_alg='dro_emo'):
        rep = {}
        for inst_name, alg_metrics in self.all_metrics.items():
            rep[inst_name] = {}
            hv_samples = {alg: [m['hypervolume'] for m in metrics]
                          for alg, metrics in alg_metrics.items()}
            try:
                kw_s, kw_p = stats.kruskal(*list(hv_samples.values()))
            except Exception:
                kw_s, kw_p = 0.0, 1.0
            rep[inst_name]['kruskal_wallis_hv'] = {
                'statistic': float(kw_s), 'p_value': float(kw_p),
                'significant': bool(kw_p < 0.05)}
            ref_hv = hv_samples[reference_alg]
            for other, other_hv in hv_samples.items():
                if other == reference_alg: continue
                try:
                    u_s, u_p = stats.mannwhitneyu(ref_hv, other_hv,
                                                  alternative='two-sided')
                except Exception:
                    u_s, u_p = 0.0, 1.0
                d = cohens_d(ref_hv, other_hv)
                cd = cliffs_delta(ref_hv, other_hv)
                rep[inst_name][f'{reference_alg}_vs_{other}'] = {
                    'mann_whitney_U': float(u_s), 'p_value': float(u_p),
                    'significant': bool(u_p < 0.05),
                    'cohens_d': float(d), 'effect_size': interpret_d(d),
                    'cliffs_delta': float(cd),
                    'mean_ref': float(np.mean(ref_hv)) if ref_hv else 0.0,
                    'mean_other': float(np.mean(other_hv)) if other_hv else 0.0}
            det_metrics = self.all_det_metrics.get(inst_name, {})
            if reference_alg in det_metrics:
                ref_cost = [m['det_best_cost'] for m in det_metrics[reference_alg]]
                ref_co2 = [m['det_best_emission'] for m in det_metrics[reference_alg]]
                for other in det_metrics:
                    if other == reference_alg: continue
                    other_cost = [m['det_best_cost'] for m in det_metrics[other]]
                    other_co2 = [m['det_best_emission'] for m in det_metrics[other]]
                    n = min(len(ref_cost), len(other_cost))
                    try:
                        w_s, w_p = stats.wilcoxon(ref_cost[:n], other_cost[:n],
                                                  alternative='two-sided')
                    except Exception:
                        w_s, w_p = 0.0, 1.0
                    try:
                        w_s2, w_p2 = stats.wilcoxon(ref_co2[:n], other_co2[:n],
                                                    alternative='two-sided')
                    except Exception:
                        w_s2, w_p2 = 0.0, 1.0
                    rep[inst_name][f'{reference_alg}_vs_{other}_det'] = {
                        'wilcoxon_cost_stat': float(w_s),
                        'wilcoxon_cost_p': float(w_p),
                        'wilcoxon_co2_stat': float(w_s2),
                        'wilcoxon_co2_p': float(w_p2),
                        'mean_ref_cost': float(np.mean(ref_cost)) if ref_cost else 0.0,
                        'mean_other_cost': float(np.mean(other_cost)) if other_cost else 0.0,
                        'mean_ref_co2': float(np.mean(ref_co2)) if ref_co2 else 0.0,
                        'mean_other_co2': float(np.mean(other_co2)) if other_co2 else 0.0}
        return rep

    def _safe(self, fn, *a, **kw):
        try: fn(*a, **kw)
        except Exception as e:
            log(f"    [warn] {fn.__name__} failed: {type(e).__name__}: {e}")

    def generate_report(self, output_dir, stats_report):
        os.makedirs(output_dir, exist_ok=True)
        stat_dir = os.path.join(output_dir, 'statistics')
        os.makedirs(stat_dir, exist_ok=True)
        ts = datetime.now().strftime('%Y%m%d_%H%M%S')
        serializable = {'summary': self._serialize(self.results),
                        'statistics': self._serialize(stats_report)}
        with open(os.path.join(output_dir, f'results_{ts}.json'), 'w') as f:
            json.dump(serializable, f, indent=2)
        self._safe(self._write_summary_tables, output_dir)
        self._safe(self._write_statistics_tables, output_dir, stats_report)
        self._safe(self._plot_heatmap, output_dir, stat_dir)
        self._safe(self._plot_instance_level_boxplots, stat_dir)
        log(f"\nReport generated in {output_dir}")

    def _write_summary_tables(self, output_dir):
        lines = ["=" * 140,
                 "PER-INSTANCE SUMMARY — HYPERVOLUME (global, normalized ref in [0,1])",
                 "=" * 140,
                 f"{'Instance':<14} {'Algorithm':<12} {'Rel.HV':<8} "
                 f"{'HV mean':<12} {'HV std':<12} "
                 f"{'Det cost':<14} {'Det CO2':<12} {'Det time':<12}",
                 "-" * 140]
        for inst, alg_results in sorted(self.results.items()):
            hv_means = {alg: r['summary']['hypervolume']['mean']
                        for alg, r in alg_results.items()}
            best_hv = max(hv_means.values()) if hv_means else 1.0
            best_hv = best_hv if best_hv > 0 else 1.0
            for alg, r in sorted(alg_results.items(),
                                 key=lambda x: -x[1]['summary']['hypervolume']['mean']):
                s = r['summary']
                rel_hv = s['hypervolume']['mean'] / best_hv
                lines.append(
                    f"{inst:<14} {alg:<12} "
                    f"{rel_hv:<8.4f} "
                    f"{s['hypervolume']['mean']:<12.4f} "
                    f"{s['hypervolume']['std']:<12.4f} "
                    f"{s['det_best_cost']['mean']:<14.4g} "
                    f"{s['det_best_emission']['mean']:<12.4g} "
                    f"{s['det_best_time']['mean']:<12.4g}")
            lines.append("-" * 140)
        txt = '\n'.join(lines)
        log(txt)
        with open(os.path.join(output_dir, 'summary_table.txt'), 'w') as f:
            f.write(txt)

    def _write_statistics_tables(self, output_dir, stats_report):
        lines = ["=" * 140,
                 "STATISTICAL VALIDATION (HV normalized, Mann-Whitney U vs DRO-EMO)",
                 "=" * 140,
                 f"{'Instance':<14} {'Comparison':<24} {'p-value':<12} "
                 f"{'Signif.':<8} {'Cohen d':<10} {'Effect':<10} {'Cliff d':<10}",
                 "-" * 140]
        for inst, rep in stats_report.items():
            for key, val in rep.items():
                if key.startswith('kruskal'): continue
                if key.endswith('_det'): continue
                lines.append(
                    f"{inst:<14} {key:<24} {val['p_value']:<12.4g} "
                    f"{str(val['significant']):<8} {val['cohens_d']:<10.4f} "
                    f"{val['effect_size']:<10} {val['cliffs_delta']:<10.3f}")
            lines.append("-" * 140)
        txt = '\n'.join(lines)
        with open(os.path.join(output_dir, 'statistics_table.txt'), 'w') as f:
            f.write(txt)
        log("  [ok] statistics_table.txt")

        lines2 = ["=" * 140,
                  "PAIRED WILCOXON ON DETERMINISTIC METRICS (DRO-EMO vs each)",
                  "=" * 140,
                  f"{'Instance':<14} {'Comparison':<24} {'p(cost)':<12} "
                  f"{'p(CO2)':<12} {'Ref cost':<14} {'Other cost':<14} "
                  f"{'Ref CO2':<12} {'Other CO2':<12}",
                  "-" * 140]
        for inst, rep in stats_report.items():
            for key, val in rep.items():
                if not key.endswith('_det'): continue
                lines2.append(
                    f"{inst:<14} {key[:-4]:<24} "
                    f"{val['wilcoxon_cost_p']:<12.4g} "
                    f"{val['wilcoxon_co2_p']:<12.4g} "
                    f"{val['mean_ref_cost']:<14.4g} "
                    f"{val['mean_other_cost']:<14.4g} "
                    f"{val['mean_ref_co2']:<12.4g} "
                    f"{val['mean_other_co2']:<12.4g}")
            lines2.append("-" * 140)
        with open(os.path.join(output_dir, 'paired_wilcoxon_det.txt'), 'w') as f:
            f.write('\n'.join(lines2))
        log("  [ok] paired_wilcoxon_det.txt")

    def _plot_heatmap(self, output_dir, stat_dir):
        instances = sorted(self.results.keys())
        if not instances: return
        algs = sorted(self.results[instances[0]].keys())
        M = np.zeros((len(instances), len(algs)))
        for i, inst in enumerate(instances):
            for j, alg in enumerate(algs):
                M[i, j] = self.results[inst][alg]['summary']['hypervolume']['mean']
        rmax = M.max(axis=1, keepdims=True); rmax[rmax == 0] = 1.0
        Mn = M / rmax
        fig, ax = plt.subplots(figsize=(10, max(6, 0.4 * len(instances))))
        im = ax.imshow(Mn, cmap=_get_cmap('RdYlGn'), aspect='auto', vmin=0, vmax=1)
        ax.set_xticks(range(len(algs)))
        ax.set_xticklabels(algs, rotation=45, ha='right')
        ax.set_yticks(range(len(instances))); ax.set_yticklabels(instances)
        plt.colorbar(im, ax=ax, label='Normalized HV (global ref, in [0,1])')
        ax.set_title('HV Heatmap (global reference, per-instance normalized)',
                     fontweight='bold')
        plt.tight_layout()
        plt.savefig(os.path.join(stat_dir, 'heatmap.png'), dpi=200,
                    bbox_inches='tight'); plt.close(fig)
        log("  [ok] heatmap.png")

    def _plot_instance_level_boxplots(self, stat_dir):
        fig, ax = plt.subplots(figsize=(12, 6))
        data_by_alg = {}
        for inst, alg_results in self.results.items():
            for alg, r in alg_results.items():
                data_by_alg.setdefault(alg, []).append(
                    r['summary']['hypervolume']['mean'])
        names = list(data_by_alg.keys())
        vals = [[v for v in data_by_alg[n] if np.isfinite(v)] for n in names]
        valid = [(n, v) for n, v in zip(names, vals) if v]
        if valid:
            names, vals = zip(*valid)
            bp = ax.boxplot(vals, patch_artist=True, showmeans=True)
            ax.set_xticklabels(names, rotation=45, ha='right')
            for p, c in zip(bp['boxes'], _tab_colors(len(names))):
                p.set_facecolor(c); p.set_alpha(0.7)
            ax.set_ylabel('Mean HV per instance (global ref, in [0,1])')
            ax.set_title('HV Distribution Across Prins Instances', fontweight='bold')
            ax.grid(True, alpha=0.3)
        plt.tight_layout()
        plt.savefig(os.path.join(stat_dir, 'instance_level_boxplots.png'),
                    dpi=200, bbox_inches='tight'); plt.close(fig)
        log("  [ok] instance_level_boxplots.png")

    @staticmethod
    def _serialize(obj):
        if isinstance(obj, np.integer): return int(obj)
        if isinstance(obj, np.floating):
            return float(obj) if np.isfinite(obj) else None
        if isinstance(obj, np.ndarray): return obj.tolist()
        if isinstance(obj, dict):
            return {k: BenchmarkRunner._serialize(v) for k, v in obj.items()}
        if isinstance(obj, (list, tuple)):
            return [BenchmarkRunner._serialize(v) for v in obj]
        if isinstance(obj, float):
            return obj if np.isfinite(obj) else None
        if isinstance(obj, (int, str, bool)) or obj is None: return obj
        return str(obj)


