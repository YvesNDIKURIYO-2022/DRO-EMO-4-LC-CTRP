class LCCLRP:
    def __init__(self, instance, evaluation_mode='dro'):
        self.instance = instance
        self.n_var = instance.n_customers
        self.n_obj = 3
        self.evaluation_mode = evaluation_mode
        if evaluation_mode not in ('deterministic', 'stochastic', 'dro'):
            raise ValueError(f"Unknown evaluation_mode={evaluation_mode!r}")
        self.depot_list = list(instance.depots.keys())
        self.customer_list = list(instance.customers.keys())
        pts = [(instance.depots[d]["x"], instance.depots[d]["y"]) for d in self.depot_list]
        pts += [(instance.customers[c]["x"], instance.customers[c]["y"]) for c in self.customer_list]
        pts = np.array(pts, dtype=float)
        self.D = np.linalg.norm(pts[:, None, :] - pts[None, :, :], axis=2)
        self.n_depots = instance.n_depots
        self.n_customers = instance.n_customers
        self._demands = np.array([instance.customers[c]["demand"] for c in self.customer_list], dtype=float)
        self._depot_caps = np.array([instance.depots[d]["capacity"] for d in self.depot_list], dtype=float)
        self._depot_open_cost = np.array([instance.depots[d]["opening_cost"] for d in self.depot_list], dtype=float)
        self._depot_fixed_em = np.array([instance.depots[d].get("fixed_emission", 0.0) for d in self.depot_list], dtype=float)
        self._build_stochastic_grid()
        self._build_ambiguity_set()
        self.dro = DROEvaluator(self.ambiguity)

    def _build_ambiguity_set(self):
        dm = np.array([0.85, 0.95, 1.00, 1.05, 1.15])
        tm = np.array([0.90, 0.95, 1.00, 1.10, 1.30])
        em = np.array([0.95, 0.98, 1.00, 1.02, 1.05])
        probs = np.array([0.15, 0.20, 0.30, 0.20, 0.15])
        res = np.column_stack([dm - 1, tm - 1, em - 1])
        w = probs / probs.sum()
        rng = np.random.default_rng(hash(self.instance.name) % 2 ** 32)
        idx = rng.choice(len(res), size=max(50, len(res) * 20), p=w, replace=True)
        self.ambiguity = AmbiguitySet.from_residuals(res[idx], 0.95)

    def _build_stochastic_grid(self):
        dm = np.array([0.85, 0.95, 1.00, 1.05, 1.15])
        tm = np.array([0.90, 0.95, 1.00, 1.10, 1.30])
        em = np.array([0.95, 0.98, 1.00, 1.02, 1.05])
        probs = np.array([0.15, 0.20, 0.30, 0.20, 0.15])
        probs = probs / probs.sum()
        grid = np.array([[a, b, c] for a in dm for b in tm for c in em], dtype=float)
        joint = np.array([pa * pb * pc for pa in probs for pb in probs for pc in probs], dtype=float)
        joint = joint / joint.sum()
        self._stoch_grid = grid; self._stoch_weights = joint

    def _decode(self, x):
        x = np.clip(np.asarray(x, dtype=float), 0, 1)
        if self.n_depots > 0:
            flags = x[:self.n_depots] >= 0.5
            if not np.any(flags):
                flags[np.argmax(x[:self.n_depots])] = True
            open_depots = [i for i, f in enumerate(flags) if f]
        else:
            open_depots = [0]
        og = x[self.n_depots:self.n_depots + self.n_customers]
        if len(og) < self.n_customers:
            og = np.pad(og, (0, self.n_customers - len(og)), constant_values=0.5)
        order = np.argsort(og)
        caps = {d: self._depot_caps[d] for d in open_depots}
        demands = self._demands; Dloc = self.D; n_dep = self.n_depots
        vcap = self.instance.vehicle_capacity
        routes = []
        for c in order:
            dem = demands[c]
            best_d, best_dist = None, np.inf
            for d in open_depots:
                if caps[d] < dem: continue
                dd = Dloc[d, n_dep + c]
                if dd < best_dist: best_dist = dd; best_d = d
            if best_d is None:
                best_d = max(open_depots, key=lambda d: caps[d])
            placed = False
            for r_i, (dep, seq, load) in enumerate(routes):
                if dep != best_d: continue
                if load + dem <= vcap:
                    seq.append(c); routes[r_i] = (dep, seq, load + dem)
                    placed = True; break
            if not placed: routes.append((best_d, [c], dem))
            caps[best_d] -= dem
        route_nodes = [(dep, [n_dep + c for c in seq]) for dep, seq, _ in routes]
        return open_depots, route_nodes

    def decode_routes(self, x): return self._decode(x)

    def _nominal_evaluate(self, x, return_L=False):
        try:
            open_depots, routes = self._decode(x)
        except Exception:
            return (1e10, 1e10, 1e10, 0.0) if return_L else (1e10, 1e10, 1e10)
        depot_cost = float(self._depot_open_cost[open_depots].sum()) if open_depots else 0.0
        depot_em = float(self._depot_fixed_em[open_depots].sum()) if open_depots else 0.0
        d_cost = 0.0; d_em = 0.0; t_tot = 0.0; veh_fix = 0.0
        p = self.instance.params; Dloc = self.D; n_dep = self.n_depots
        demands = self._demands
        vcap = max(self.instance.vehicle_capacity, 1.0)
        for dep, seq in routes:
            veh_fix += self.instance.vehicle_fixed_cost
            path = [dep] + seq + [dep]
            load = sum(demands[c - n_dep] for c in seq)
            for i in range(len(path) - 1):
                a, b = path[i], path[i + 1]
                dkm = Dloc[a, b]; lf = load / vcap
                fpk = p.diesel_cons_empty + (p.diesel_cons_full - p.diesel_cons_empty) * lf
                d_cost += fpk * dkm * p.diesel_unit_cost
                d_em += fpk * dkm * p.emission_coefficient
                t_tot += dkm / p.avg_speed_kmh
                if b >= n_dep:
                    ci = b - n_dep
                    load -= demands[ci]
                    if load < 0.0: load = 0.0
            t_tot += p.service_time_h * len(seq)
        carbon_cost = p.carbon_treatment_cost * d_em
        res = (float(depot_cost + veh_fix + d_cost + carbon_cost),
               float(depot_em + d_em), float(t_tot))
        if return_L:
            L_total = 0.0
            for dep, seq in routes:
                path = [dep] + seq + [dep]
                L_total += float(sum(Dloc[path[i], path[i + 1]] for i in range(len(path) - 1)))
            return res, L_total
        return res

    def _exact_sensitivities(self, x, L_total):
        p = self.instance.params
        b_time_tau = L_total / p.avg_speed_kmh
        b_em_gamma = L_total * p.emission_coefficient
        total_demand = float(self._demands.sum()) if self._demands.size else 1.0
        dL = L_total / max(total_demand, 1.0)
        b_cost_d = dL * p.diesel_unit_cost * (p.diesel_cons_empty + p.diesel_cons_full) / 2.0
        b_cost_gamma = L_total * p.emission_coefficient * p.carbon_treatment_cost
        return (np.nan_to_num(np.array([b_cost_d, 0.0, b_cost_gamma])),
                np.nan_to_num(np.array([0.0, 0.0, b_em_gamma])),
                np.nan_to_num(np.array([0.0, b_time_tau, 0.0])))

    def evaluate(self, x):
        (bc, be, bt), L_total = self._nominal_evaluate(x, return_L=True)
        if self.evaluation_mode == 'deterministic':
            return (float(bc), float(be), float(bt))
        if self.evaluation_mode == 'stochastic':
            return self._stochastic_evaluate(x)
        b_cost, b_em, b_time = self._exact_sensitivities(x, L_total)
        return (float(self.dro.pi(bc, b_cost)),
                float(self.dro.pi(be, b_em)),
                float(self.dro.pi(bt, b_time)))

    def evaluate_deterministic(self, x): return self._nominal_evaluate(x)

    def _stochastic_evaluate(self, x, n_samples=150):
        try:
            open_depots, routes = self._decode(x)
        except Exception:
            return 1e10, 1e10, 1e10
        p = self.instance.params; Dloc = self.D; n_dep = self.n_depots
        demands = self._demands
        vcap = max(self.instance.vehicle_capacity, 1.0)
        depot_cost = float(self._depot_open_cost[open_depots].sum()) if open_depots else 0.0
        depot_em = float(self._depot_fixed_em[open_depots].sum()) if open_depots else 0.0
        legs_cost = []; legs_em = []; legs_time = []
        veh_fix = 0.0; service_time_total = 0.0
        for dep, seq in routes:
            veh_fix += self.instance.vehicle_fixed_cost
            path = [dep] + seq + [dep]
            load = sum(demands[c - n_dep] for c in seq)
            for i in range(len(path) - 1):
                a, b = path[i], path[i + 1]
                dkm = Dloc[a, b]; lf = load / vcap
                fpk = p.diesel_cons_empty + (p.diesel_cons_full - p.diesel_cons_empty) * lf
                legs_cost.append(fpk * dkm * p.diesel_unit_cost)
                legs_em.append(fpk * dkm * p.emission_coefficient)
                legs_time.append(dkm / p.avg_speed_kmh)
                if b >= n_dep:
                    ci = b - n_dep
                    load -= demands[ci]
                    if load < 0.0: load = 0.0
            service_time_total += p.service_time_h * len(seq)
        if not legs_cost:
            return (float(depot_cost + veh_fix), float(depot_em), float(service_time_total))
        legs_cost = np.asarray(legs_cost, dtype=float)
        legs_em = np.asarray(legs_em, dtype=float)
        legs_time = np.asarray(legs_time, dtype=float)
        rng = np.random.default_rng(hash((self.instance.name, 'stoch')) % 2 ** 32)
        idx = rng.choice(len(self._stoch_grid), size=n_samples, p=self._stoch_weights)
        scen = self._stoch_grid[idx]
        cost_m = scen[:, 0]; time_m = scen[:, 1]; emis_m = scen[:, 2]
        s_cost_travel = (cost_m[:, None] * legs_cost[None, :]).sum(axis=1)
        s_em_travel = (emis_m[:, None] * legs_em[None, :]).sum(axis=1)
        s_time_travel = (time_m[:, None] * legs_time[None, :]).sum(axis=1)
        s_cost = depot_cost + veh_fix + s_cost_travel + p.carbon_treatment_cost * s_em_travel
        s_em = depot_em + s_em_travel
        s_time = s_time_travel + service_time_total
        return (float(s_cost.mean()), float(s_em.mean()), float(s_time.mean()))


