@dataclass
class AmbiguitySet:
    W_lower: np.ndarray; W_upper: np.ndarray
    mean_hat: np.ndarray; mean_lower: np.ndarray; mean_upper: np.ndarray
    Sigma: np.ndarray; sigma_f: np.ndarray; sigma_b: np.ndarray
    H_sigma: np.ndarray

    def dimension(self): return len(self.mean_hat)

    @staticmethod
    def from_residuals(residuals, confidence=0.95):
        residuals = np.atleast_2d(residuals)
        n, d = residuals.shape
        W_lower = residuals.min(axis=0); W_upper = residuals.max(axis=0)
        mean_hat = residuals.mean(axis=0)
        std = residuals.std(axis=0, ddof=1) if n > 1 else np.zeros(d)
        z = stats.norm.ppf((1 + confidence) / 2)
        margin = z * std / np.sqrt(max(n, 1))
        mean_lower = mean_hat - margin; mean_upper = mean_hat + margin
        Sigma = np.cov(residuals, rowvar=False) if n > 1 else np.eye(d)
        if Sigma.ndim == 0: Sigma = np.array([[float(Sigma)]])
        Sigma = 0.9 * Sigma + 0.1 * np.diag(np.diag(Sigma)) + 1e-8 * np.eye(d)
        sigma_f = AmbiguitySet._dd(residuals, +1)
        sigma_b = AmbiguitySet._dd(residuals, -1)
        eigvals, eigvecs = np.linalg.eigh(Sigma)
        eigvals = np.clip(eigvals, 1e-10, None)
        H = (eigvecs / np.sqrt(eigvals)).T
        return AmbiguitySet(W_lower, W_upper, mean_hat, mean_lower,
                            mean_upper, Sigma, sigma_f, sigma_b, H)

    @staticmethod
    def _dd(residuals, sign):
        theta_grid = np.logspace(-3, 1, 40)
        r = sign * residuals
        n, d = r.shape
        out = np.zeros(d)
        for j in range(d):
            x = r[:, j]
            zz = theta_grid[:, None] * x[None, :]
            m = zz.max(axis=1)
            lme = m + np.log(np.mean(np.exp(zz - m[:, None]), axis=1))
            val = np.sqrt(np.maximum(2.0 * lme / theta_grid ** 2, 0.0))
            out[j] = float(val.max())
        return out


class DROEvaluator:
    _LAM_GRID = np.logspace(-3, 2, 60)

    def __init__(self, amb):
        self.amb = amb
        self._cache = {}

    def _coeffs(self, r):
        key = r.tobytes()
        c = self._cache.get(key)
        if c is not None: return c
        wm = float(np.sum(np.where(r >= 0, r * self.amb.mean_upper,
                                          r * self.amb.mean_lower)))
        ws = float(np.sum(np.where(r >= 0, r * self.amb.W_upper,
                                          r * self.amb.W_lower)))
        u = np.maximum(r * self.amb.sigma_f, -r * self.amb.sigma_b)
        nu2 = float(u @ u)
        var = max(float(r @ self.amb.Sigma @ r), 0.0)
        c = (wm, ws, nu2, var)
        if len(self._cache) > 4096: self._cache.clear()
        self._cache[key] = c
        return c

    def pi1(self, r0, r):
        r = np.asarray(r, dtype=float).flatten()
        wm, ws, _, _ = self._coeffs(r)
        return max(0.0, r0 + max(ws, wm))

    def pi2(self, r0, r):
        r = np.asarray(r, dtype=float).flatten()
        wm, _, _, var = self._coeffs(r)
        mu = r0 + wm
        return (0.5 * mu + 0.5 * np.sqrt(mu ** 2 + var)) if mu >= 0 \
               else 0.5 * np.sqrt(var)

    def pi3(self, r0, r):
        r = np.asarray(r, dtype=float).flatten()
        wm, ws, nu2, _ = self._coeffs(r)
        x0 = r0 + wm; sup_z = ws
        lams = self._LAM_GRID
        e = (x0 + sup_z) / lams + nu2 / (2.0 * lams ** 2)
        log_v = np.log(lams) - 1.0 + e
        v = np.exp(np.minimum(log_v, 700.0))
        v = np.where(e > 50.0, np.inf, v)
        if not np.any(np.isfinite(v)): return self.pi1(r0, r)
        return float(np.min(v))

    def pi(self, r0, r):
        return max(self.pi1(r0, r), self.pi2(r0, r), self.pi3(r0, r))


