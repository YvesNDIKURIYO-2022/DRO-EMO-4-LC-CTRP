class PrinsInstance:
    def __init__(self, sheet_name, df):
        self.name = sheet_name
        self.raw = df
        self.is_green = sheet_name.startswith("G")
        self.depots = {}; self.customers = {}
        self.vehicle_capacity = 70.0
        self.vehicle_fixed_cost = 1000.0
        self.params = RoutingModelParams()
        self._parse(df)

    def _parse(self, df):
        rows = df.values.tolist()
        data_rows = rows[1:] if len(rows) > 1 else rows
        for row in data_rows:
            if len(row) < 4: continue
            label = row[0]
            if label is None: continue
            label_s = str(label).strip()
            if not label_s.lower().startswith("d"): continue
            try:
                x = float(row[1]); y = float(row[2])
                cap = float(row[3]) if row[3] not in (None, "", " ") else 0.0
            except (ValueError, TypeError): continue
            try:
                oc = float(row[4]) if len(row) > 4 and row[4] not in (None,""," ") else 0.0
            except (ValueError, TypeError): oc = 0.0
            fe = 0.0
            if self.is_green and len(row) > 5 and row[5] not in (None,""," "):
                try:
                    v = row[5]
                    fe = oc/10.0 if isinstance(v,str) and v.startswith("=") else float(v)
                except (ValueError, TypeError): fe = oc/10.0
            if label_s not in self.depots:
                self.depots[label_s] = {"x": x, "y": y, "capacity": cap,
                                        "opening_cost": oc, "fixed_emission": fe}
        prev_id = 0
        for row in data_rows:
            if len(row) < 4: continue
            label = row[0]
            if label is None: continue
            label_s = str(label).strip()
            if label_s.lower().startswith("d"): continue
            try: cid = int(float(label_s))
            except (ValueError, TypeError): continue
            if cid <= prev_id: continue
            try:
                x = float(row[1]); y = float(row[2])
                dem = float(row[3]) if row[3] not in (None,""," ") else 0.0
            except (ValueError, TypeError): continue
            self.customers[str(cid)] = {"x": x, "y": y, "demand": dem}
            prev_id = cid
        for row in data_rows:
            for j, cell in enumerate(row):
                if cell is None: continue
                s = str(cell).strip().lower()
                if s == "vehicle capacity":
                    for k in range(j+1, len(row)):
                        if row[k] not in (None,""," "):
                            try: self.vehicle_capacity = float(str(row[k]).split("/")[0])
                            except (ValueError, TypeError): pass
                            break
                if s == "opening cost of a route (cost of a vehicle)":
                    for k in range(j+1, len(row)):
                        if row[k] not in (None,""," "):
                            try: self.vehicle_fixed_cost = float(row[k])
                            except (ValueError, TypeError): pass
                            break

    @property
    def n_depots(self): return len(self.depots)
    @property
    def n_customers(self): return len(self.customers)
    @property
    def n_var(self): return self.n_customers
    @property
    def n_obj(self): return 3


def load_prins_instances(excel_path):
    if not os.path.isfile(excel_path):
        raise FileNotFoundError(excel_path)
    xls = pd.ExcelFile(excel_path)
    out = []
    for sheet in xls.sheet_names:
        try:
            df = pd.read_excel(excel_path, sheet_name=sheet, header=None)
            inst = PrinsInstance(sheet, df)
            if inst.n_depots == 0 or inst.n_customers == 0: continue
            out.append(inst)
        except Exception as e:
            log(f"  [skip] {sheet}: {e}")
    return out


@dataclass
class AmbiguitySet:
    W_lower: np.ndarray; W_upper: np.ndarray
    mean_hat: np.ndarray; mean_lower: np.ndarray; mean_upper: np.ndarray
    Sigma: np.ndarray; sigma_f: np.ndarray; sigma_b: np.ndarray
    H_sigma: np.ndarray
    @staticmethod
    def from_residuals(residuals, confidence=0.95):
        residuals = np.atleast_2d(residuals)
        n, d = residuals.shape
        W_lower = residuals.min(axis=0); W_upper = residuals.max(axis=0)
        mean_hat = residuals.mean(axis=0)
        std = residuals.std(axis=0, ddof=1) if n > 1 else np.zeros(d)
        z = stats.norm.ppf((1+confidence)/2)
        margin = z*std/np.sqrt(max(n,1))
        mean_lower = mean_hat - margin; mean_upper = mean_hat + margin
        Sigma = np.cov(residuals, rowvar=False) if n > 1 else np.eye(d)
        if Sigma.ndim == 0: Sigma = np.array([[float(Sigma)]])
        Sigma = 0.9*Sigma + 0.1*np.diag(np.diag(Sigma)) + 1e-8*np.eye(d)
        sigma_f = AmbiguitySet._dd(residuals, +1)
        sigma_b = AmbiguitySet._dd(residuals, -1)
        eigvals, eigvecs = np.linalg.eigh(Sigma)
        eigvals = np.clip(eigvals, 1e-10, None)
        H = (eigvecs / np.sqrt(eigvals)).T
        return AmbiguitySet(W_lower, W_upper, mean_hat, mean_lower,
                            mean_upper, Sigma, sigma_f, sigma_b, H)
    @staticmethod
    def _dd(residuals, sign):
        theta_grid = np.logspace(-3, 1, 40)
        r = sign * residuals
        n, d = r.shape
        out = np.zeros(d)
        for j in range(d):
            x = r[:, j]
            zz = theta_grid[:, None] * x[None, :]
            m = zz.max(axis=1)
            lme = m + np.log(np.mean(np.exp(zz - m[:, None]), axis=1))
            val = np.sqrt(np.maximum(2.0*lme/theta_grid**2, 0.0))
            out[j] = float(val.max())
        return out


class DROEvaluator:
    _LAM_GRID = np.logspace(-3, 2, 60)
    def __init__(self, amb):
        self.amb = amb; self._cache = {}
    def _coeffs(self, r):
        key = r.tobytes(); c = self._cache.get(key)
        if c is not None: return c
        wm = float(np.sum(np.where(r>=0, r*self.amb.mean_upper, r*self.amb.mean_lower)))
        ws = float(np.sum(np.where(r>=0, r*self.amb.W_upper, r*self.amb.W_lower)))
        u = np.maximum(r*self.amb.sigma_f, -r*self.amb.sigma_b)
        nu2 = float(u @ u)
        var = max(float(r @ self.amb.Sigma @ r), 0.0)
        c = (wm, ws, nu2, var)
        if len(self._cache) > 4096: self._cache.clear()
        self._cache[key] = c
        return c
    def pi1(self, r0, r):
        r = np.asarray(r, dtype=float).flatten()
        wm, ws, _, _ = self._coeffs(r)
        return max(0.0, r0 + max(ws, wm))
    def pi2(self, r0, r):
        r = np.asarray(r, dtype=float).flatten()
        wm, _, _, var = self._coeffs(r)
        mu = r0 + wm
        return (0.5*mu + 0.5*np.sqrt(mu**2 + var)) if mu >= 0 else 0.5*np.sqrt(var)
    def pi3(self, r0, r):
        r = np.asarray(r, dtype=float).flatten()
        wm, ws, nu2, _ = self._coeffs(r)
        x0 = r0 + wm; sup_z = ws
        lams = self._LAM_GRID
        e = (x0 + sup_z)/lams + nu2/(2.0*lams**2)
        log_v = np.log(lams) - 1.0 + e
        v = np.exp(np.minimum(log_v, 700.0))
        v = np.where(e > 50.0, np.inf, v)
        if not np.any(np.isfinite(v)): return self.pi1(r0, r)
        return float(np.min(v))
    def pi(self, r0, r):
        return max(self.pi1(r0, r), self.pi2(r0, r), self.pi3(r0, r))


class LCCLRP:
    def __init__(self, instance, evaluation_mode='dro'):
        self.instance = instance
        self.n_var = instance.n_customers
        self.n_obj = 3
        self.evaluation_mode = evaluation_mode
        self.depot_list = list(instance.depots.keys())
        self.customer_list = list(instance.customers.keys())
        pts = [(instance.depots[d]["x"], instance.depots[d]["y"]) for d in self.depot_list]
        pts += [(instance.customers[c]["x"], instance.customers[c]["y"]) for c in self.customer_list]
        pts = np.array(pts, dtype=float)
        self.D = np.linalg.norm(pts[:, None, :] - pts[None, :, :], axis=2)
        self.n_depots = instance.n_depots
        self.n_customers = instance.n_customers
        self._demands = np.array([instance.customers[c]["demand"] for c in self.customer_list], dtype=float)
        self._depot_caps = np.array([instance.depots[d]["capacity"] for d in self.depot_list], dtype=float)
        self._depot_open_cost = np.array([instance.depots[d]["opening_cost"] for d in self.depot_list], dtype=float)
        self._depot_fixed_em = np.array([instance.depots[d].get("fixed_emission",0.0) for d in self.depot_list], dtype=float)
        self._build_ambiguity_set()
        self.dro = DROEvaluator(self.ambiguity)
    def _build_ambiguity_set(self):
        dm = np.array([0.85,0.95,1.00,1.05,1.15])
        tm = np.array([0.90,0.95,1.00,1.10,1.30])
        em = np.array([0.95,0.98,1.00,1.02,1.05])
        probs = np.array([0.15,0.20,0.30,0.20,0.15]); probs = probs/probs.sum()
        res = np.column_stack([dm-1, tm-1, em-1])
        rng = np.random.default_rng(hash(self.instance.name) % 2**32)
        idx = rng.choice(len(res), size=max(50, len(res)*20), p=probs, replace=True)
        self.ambiguity = AmbiguitySet.from_residuals(res[idx], 0.95)
    def _decode(self, x):
        x = np.clip(np.asarray(x, dtype=float), 0, 1)
        flags = x[:self.n_depots] >= 0.5
        if not np.any(flags): flags[np.argmax(x[:self.n_depots])] = True
        open_depots = [i for i, f in enumerate(flags) if f]
        og = x[self.n_depots:self.n_depots + self.n_customers]
        if len(og) < self.n_customers:
            og = np.pad(og, (0, self.n_customers - len(og)), constant_values=0.5)
        order = np.argsort(og)
        caps = {d: self._depot_caps[d] for d in open_depots}
        demands = self._demands; Dloc = self.D; n_dep = self.n_depots
        vcap = self.instance.vehicle_capacity
        routes = []
        for c in order:
            dem = demands[c]
            best_d, best_dist = None, np.inf
            for d in open_depots:
                if caps[d] < dem: continue
                dd = Dloc[d, n_dep + c]
                if dd < best_dist: best_dist = dd; best_d = d
            if best_d is None: best_d = max(open_depots, key=lambda d: caps[d])
            placed = False
            for r_i, (dep, seq, load) in enumerate(routes):
                if dep != best_d: continue
                if load + dem <= vcap:
                    seq.append(c); routes[r_i] = (dep, seq, load + dem)
                    placed = True; break
            if not placed: routes.append((best_d, [c], dem))
            caps[best_d] -= dem
        route_nodes = [(dep, [n_dep + c for c in seq]) for dep, seq, _ in routes]
        return open_depots, route_nodes
    def _nominal_evaluate(self, x, return_L=False):
        try: open_depots, routes = self._decode(x)
        except Exception:
            return (1e10,1e10,1e10,0.0) if return_L else (1e10,1e10,1e10)
        depot_cost = float(self._depot_open_cost[open_depots].sum()) if open_depots else 0.0
        depot_em = float(self._depot_fixed_em[open_depots].sum()) if open_depots else 0.0
        d_cost = 0.0; d_em = 0.0; t_tot = 0.0; veh_fix = 0.0
        p = self.instance.params; Dloc = self.D; n_dep = self.n_depots
        demands = self._demands; vcap = max(self.instance.vehicle_capacity, 1.0)
        for dep, seq in routes:
            veh_fix += self.instance.vehicle_fixed_cost
            path = [dep] + seq + [dep]
            load = sum(demands[c-n_dep] for c in seq)
            for i in range(len(path)-1):
                a, b = path[i], path[i+1]
                dkm = Dloc[a, b]; lf = load/vcap
                fpk = p.diesel_cons_empty + (p.diesel_cons_full - p.diesel_cons_empty)*lf
                d_cost += fpk*dkm*p.diesel_unit_cost
                d_em += fpk*dkm*p.emission_coefficient
                t_tot += dkm/p.avg_speed_kmh
                if b >= n_dep:
                    ci = b - n_dep
                    load -= demands[ci]
                    if load < 0: load = 0
            t_tot += p.service_time_h*len(seq)
        carbon_cost = p.carbon_treatment_cost * d_em
        res = (float(depot_cost + veh_fix + d_cost + carbon_cost),
               float(depot_em + d_em), float(t_tot))
        if return_L:
            L_total = 0.0
            for dep, seq in routes:
                path = [dep] + seq + [dep]
                L_total += float(sum(Dloc[path[i], path[i+1]] for i in range(len(path)-1)))
            return res, L_total
        return res
    def _exact_sensitivities(self, x, L_total):
        p = self.instance.params
        b_time_tau = L_total / p.avg_speed_kmh
        b_em_gamma = L_total * p.emission_coefficient
        total_demand = float(self._demands.sum()) if self._demands.size else 1.0
        dL = L_total / max(total_demand, 1.0)
        b_cost_d = dL * p.diesel_unit_cost * (p.diesel_cons_empty + p.diesel_cons_full)/2.0
        b_cost_gamma = L_total * p.emission_coefficient * p.carbon_treatment_cost
        return (np.nan_to_num(np.array([b_cost_d, 0.0, b_cost_gamma])),
                np.nan_to_num(np.array([0.0, 0.0, b_em_gamma])),
                np.nan_to_num(np.array([0.0, b_time_tau, 0.0])))
    def evaluate(self, x):
        (bc, be, bt), L_total = self._nominal_evaluate(x, return_L=True)
        if self.evaluation_mode == 'deterministic':
            return (float(bc), float(be), float(bt))
        b_cost, b_em, b_time = self._exact_sensitivities(x, L_total)
        return (float(self.dro.pi(bc, b_cost)),
                float(self.dro.pi(be, b_em)),
                float(self.dro.pi(bt, b_time)))
    def evaluate_deterministic(self, x):
        return self._nominal_evaluate(x)


