# METRICS
# ============================================================================
def _compute_hv(fit, ref=None, lo=None, n_samples=3000):
    try:
        F = np.asarray(fit, dtype=float)
        F = F[np.all(np.isfinite(F) & (np.abs(F) < 1e12), axis=1)]
        if len(F) == 0: return 0.0
        m = F.shape[1]
        if ref is None or lo is None:
            ref = np.where(F.max(0)*1.1 > 1e-9, F.max(0)*1.1, 1.0)
            lo = F.min(0)
        ref = np.asarray(ref, dtype=float).flatten()[:m]
        lo = np.asarray(lo, dtype=float).flatten()[:m]
        span = ref - lo; span[span < 1e-12] = 1.0
        Fn = (F - lo)/span
        le = (Fn[None, :, :] >= Fn[:, None, :]).all(axis=-1)
        sl = (Fn[None, :, :] > Fn[:, None, :]).any(axis=-1)
        dom = le & sl
        np.fill_diagonal(dom, False)
        nd = Fn[~dom.any(axis=1)]
        if len(nd) == 0: return 0.0
        rng = np.random.default_rng(0)
        pts = rng.uniform(0, 1, (n_samples, m))
        inside = (pts[:, None, :] >= nd[None, :, :]).all(axis=2).any(axis=1)
        return float(inside.mean())
    except Exception:
        return 0.0

def compute_metrics_3obj(pareto_fit, ref=None, lo=None):
    if pareto_fit is None or len(pareto_fit) == 0:
        return {'hypervolume': 0.0, 'best_cost': float('inf'),
                'best_emission': float('inf'), 'best_time': float('inf')}
    F = np.asarray(pareto_fit, dtype=float)
    F = F[np.all(np.isfinite(F) & (np.abs(F) < 1e12), axis=1)]
    if len(F) == 0:
        return {'hypervolume': 0.0, 'best_cost': float('inf'),
                'best_emission': float('inf'), 'best_time': float('inf')}
    hv = _compute_hv(F, ref=ref, lo=lo, n_samples=10000)
    return {'hypervolume': float(hv),
            'best_cost': float(F[:,0].min()),
            'best_emission': float(F[:,1].min()),
            'best_time': float(F[:,2].min())}

def cliffs_delta(a, b):
    a = np.asarray([x for x in a if np.isfinite(x)], dtype=float)
    b = np.asarray([x for x in b if np.isfinite(x)], dtype=float)
    if len(a) == 0 or len(b) == 0: return 0.0
    gt = (a[:, None] > b[None, :]).sum()
    lt = (a[:, None] < b[None, :]).sum()
    return float((gt - lt)/(len(a)*len(b)))


# ============================================================================
# DETERMINISTIC DECODE + ROBUST REFERENCE BOX
# ============================================================================
def _decode_front_to_deterministic(problem, pop):
    if pop is None or len(pop) == 0:
        return np.empty((0, 3), dtype=float)
    rows = []
    for s in pop:
        try:
            c, e, t = problem.evaluate_deterministic(s)
            if np.isfinite(c) and np.isfinite(e) and np.isfinite(t):
                rows.append((float(c), float(e), float(t)))
        except Exception:
            continue
    return np.asarray(rows, dtype=float) if rows else np.empty((0, 3))

def _robust_reference_box(arrays, upper_q=0.95, lower_q=0.05, pad=1.05):
    ne = [a for a in arrays if a is not None and len(a) > 0
          and np.all(np.isfinite(a) & (np.abs(a) < 1e12))]
    if not ne: return None, None
    P = np.vstack(ne)
    if len(P) == 0: return None, None
    q_hi = np.quantile(P, upper_q, axis=0)
    q_lo = np.quantile(P, lower_q, axis=0)
    ref = np.where(q_hi * pad > 1e-9, q_hi * pad, 1.0)
    lo = q_lo
    span = ref - lo
    bad = span < 1e-12
    if np.any(bad): ref[bad] = lo[bad] + 1.0
    return ref, lo


