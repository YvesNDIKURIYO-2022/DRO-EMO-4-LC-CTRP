# SIZE CLASSES + VARIANT DEFINITIONS
# ============================================================================
ABLATION_VARIANTS = [
    ('full',            {}),
    ('no-DRO',          {'use_dro_bound': False}),
    ('no-PPO',          {'use_ppo_init': False}),
    ('no-adaptive',     {'use_adaptive_operators': False}),
    ('no-local-search', {'use_local_search': False}),
]

def _size_class(inst_name):
    """
    Return the size class of an instance:
      - 'G-n' for green instances with n customers
      - 'n' for non-green instances with n customers
    where n is the customer count parsed from the name.
    Examples:
      '20-5-1a'     -> '20'
      '50-5-2ab'    -> '50'
      '100-10-1ab'  -> '100'
      '200-10-3ab'  -> '200'
      'G20-5-1a'    -> 'G20'
      'G200-10-1ab' -> 'G200'
    """
    s = str(inst_name)
    prefix = 'G' if s.startswith('G') else ''
    body = s[1:] if prefix else s
    for tok in body.replace('-', '_').split('_'):
        if tok.isdigit():
            return f"{prefix}{int(tok)}"
    return f"{prefix}unknown"


# ============================================================================
# ABLATION RUNNER
# ============================================================================
class AblationRunner:
    def __init__(self, base_cfg, base_seed=42):
        self.base_cfg = base_cfg
        self.base_seed = base_seed
        self.rows = []
        self.per_run = []
        self.eval_rows = []
        np.random.seed(base_seed); random.seed(base_seed)

    def _get_seed(self, run): return self.base_seed + run

    # ------------------------------------------------------------------
    # PART B — ablation with deterministic decode
    # ------------------------------------------------------------------
    def run_ablation(self, instances, num_runs=10):
        log("\n" + "=" * 70)
        log("PART B — COMPONENT ABLATION (deterministic-decode scoring)")
        log("=" * 70)
        variants = [(n, replace(self.base_cfg, **ov))
                    for n, ov in ABLATION_VARIANTS]
        self.rows = []; self.per_run = []

        for inst in instances:
            log(f"\n  Instance: {inst.name}  "
                f"(size-class {_size_class(inst.name)})")
            problem = LCCLRP(inst, evaluation_mode='dro')
            raw_det = {}
            for vname, vcfg in variants:
                t0 = time.time()
                det_fronts = []
                for run in range(num_runs):
                    seed = self._get_seed(run)
                    np.random.seed(seed); random.seed(seed)
                    try:
                        algo = DROEMO(problem, vcfg)
                        result = algo.run()
                        pop = result.get('population', [])
                    except Exception as e:
                        log(f"    [warn] {vname} run={run} failed: {e}")
                        pop = []
                    det = _decode_front_to_deterministic(problem, pop)
                    det_fronts.append(det)
                raw_det[vname] = det_fronts
                n_ok = sum(1 for d in det_fronts if len(d) > 0)
                log(f"    {vname:<18} {n_ok}/{num_runs} non-empty "
                    f"({time.time()-t0:.1f}s)")

            pooled = [d for fl in raw_det.values() for d in fl]
            ref, lo = _robust_reference_box(pooled)

            for vname, _ in variants:
                hvs, bcs, bco2s, bts = [], [], [], []
                for run_idx, det in enumerate(raw_det[vname]):
                    m = compute_metrics_3obj(det, ref=ref, lo=lo)
                    hvs.append(m['hypervolume']); bcs.append(m['best_cost'])
                    bco2s.append(m['best_emission']); bts.append(m['best_time'])
                    self.per_run.append({
                        'Instance': inst.name,
                        'SizeClass': _size_class(inst.name),
                        'Variant': vname,
                        'Run': run_idx,
                        'Hypervolume': float(m['hypervolume']),
                        'Best_Cost': float(m['best_cost']),
                        'Best_CO2': float(m['best_emission']),
                        'Best_Time': float(m['best_time']),
                    })
                if not hvs:
                    hvs = [0.0]; bcs=[np.nan]; bco2s=[np.nan]; bts=[np.nan]
                log(f"    {vname:<18} HV_det={np.mean(hvs):.4f} "
                    f"±{np.std(hvs):.4f}  cost={np.nanmean(bcs):.6g}  "
                    f"CO2={np.nanmean(bco2s):.6g}")
                self.rows.append({
                    'Instance': inst.name,
                    'SizeClass': _size_class(inst.name),
                    'Variant': vname,
                    'Hypervolume_mean': float(np.mean(hvs)),
                    'Hypervolume_std': float(np.std(hvs)),
                    'Best_Cost_mean': float(np.nanmean(bcs)),
                    'Best_CO2_mean': float(np.nanmean(bco2s)),
                    'Best_Time_mean': float(np.nanmean(bts)),
                    'N_Runs': num_runs,
                })

        self._write_ablation_outputs()
        return pd.DataFrame(self.rows)

    def _write_ablation_outputs(self):
        if not self.rows: return
        df = pd.DataFrame(self.rows)
        df.to_csv(os.path.join(ABLATION_DIR, 'ablation_results.csv'), index=False)
        if self.per_run:
            pd.DataFrame(self.per_run).to_csv(
                os.path.join(ABLATION_DIR, 'ablation_per_run.csv'), index=False)
        log(f"\n  [ok] Saved ablation_results.csv and ablation_per_run.csv")

    def write_size_class_summary(self):
        """
        Group the ablation results by size class and report, per size
        class, the mean HV of each variant and its loss relative to full.
        """
        if not self.rows:
            return
        df = pd.DataFrame(self.rows)
        log("\n" + "=" * 78)
        log("ABLATION SUMMARY BY SIZE CLASS (mean HV on deterministic decode)")
        log("=" * 78)
        # Sort size classes numerically when possible.
        def _size_key(sc):
            s = str(sc).lstrip('G')
            try: return (0 if not str(sc).startswith('G') else 1, int(s))
            except ValueError: return (2, 0)
        size_classes = sorted(df['SizeClass'].unique(), key=_size_key)

        lines = []
        header = f"{'SizeClass':<10} " + "".join(
            f"{v:<18}" for v, _ in ABLATION_VARIANTS) + "  | N_inst"
        lines.append(header)
        lines.append("-" * len(header))
        for sc in size_classes:
            sub = df[df['SizeClass'] == sc]
            n_inst = sub['Instance'].nunique()
            row_vals = {}
            for vname, _ in ABLATION_VARIANTS:
                vsub = sub[sub['Variant'] == vname]
                row_vals[vname] = vsub['Hypervolume_mean'].mean() \
                    if len(vsub) else float('nan')
            full_hv = row_vals.get('full', float('nan'))
            cells = []
            for vname, _ in ABLATION_VARIANTS:
                hv = row_vals[vname]
                if vname == 'full' or not np.isfinite(full_hv) or full_hv == 0:
                    cells.append(f"{hv:.4f}         ")
                else:
                    pct = 100.0 * (full_hv - hv) / full_hv
                    cells.append(f"{hv:.4f}({pct:+.1f}%)")
            lines.append(f"{sc:<10} " + "".join(f"{c:<18}" for c in cells)
                         + f"  | {n_inst}")
        lines.append("")
        lines.append("Format: HV (loss vs full).  Positive loss = variant is worse.")
        lines.append("")
        txt = "\n".join(lines)
        log(txt)
        with open(os.path.join(ABLATION_DIR, 'ablation_by_size_class.txt'), 'w') as f:
            f.write(txt)

    # ------------------------------------------------------------------
    # PART B — paired Wilcoxon, stratified by size class
    # ------------------------------------------------------------------
    def statistical_analysis_ablation_by_size_class(
            self, reference='full', alpha=0.05, bonferroni=4):
        """
        Paired Wilcoxon on per-run HV, grouped by size class.
        Within each size class, we pool the per-run paired differences
        across all instances of that class (matched by run index).
        """
        if not self.per_run:
            log("  [warn] no per-run rows; skipping ablation stats")
            return None
        df = pd.DataFrame(self.per_run)
        ab = alpha / bonferroni

        def _size_key(sc):
            s = str(sc).lstrip('G')
            try: return (0 if not str(sc).startswith('G') else 1, int(s))
            except ValueError: return (2, 0)
        size_classes = sorted(df['SizeClass'].unique(), key=_size_key)

        rows = []
        lines = ["=" * 130,
                 "PART B — PAIRED WILCOXON ON ABLATION HV, BY SIZE CLASS",
                 f"Reference: {reference}   alpha={alpha}   Bonf={ab:.4f}",
                 "Pooling per-run paired differences across all instances",
                 "of the same size class, matched by run index.",
                 "=" * 130,
                 f"{'SizeClass':<10} {'Comparison':<24} {'N':<4} "
                 f"{'Median_diff':<14} {'Mean_diff':<14} "
                 f"{'p':<12} {'Sig':<6} {'Cliff d':<10}",
                 "-" * 130]

        for sc in size_classes:
            sub = df[df['SizeClass'] == sc]
            for vname, _ in ABLATION_VARIANTS:
                if vname == reference: continue
                diffs_pooled = []
                for inst in sub['Instance'].unique():
                    ist = sub[sub['Instance'] == inst]
                    ref = ist[ist['Variant'] == reference].set_index('Run')
                    var = ist[ist['Variant'] == vname].set_index('Run')
                    common = ref.index.intersection(var.index)
                    if len(common) < 1: continue
                    d = (ref.loc[common, 'Hypervolume'].values
                         - var.loc[common, 'Hypervolume'].values)
                    diffs_pooled.extend(d.tolist())
                diffs_pooled = np.asarray(diffs_pooled, dtype=float)
                diffs_pooled = diffs_pooled[np.isfinite(diffs_pooled)]
                if len(diffs_pooled) < 5: continue
                if np.all(diffs_pooled == 0):
                    stat, p = float('nan'), 1.0; cd = 0.0
                else:
                    try:
                        stat, p = stats.wilcoxon(diffs_pooled,
                                                 alternative='two-sided')
                    except Exception:
                        stat, p = float('nan'), float('nan')
                    a = diffs_pooled[diffs_pooled > 0]
                    b = -diffs_pooled[diffs_pooled < 0]
                    cd = cliffs_delta(a, b) if len(a) and len(b) else 0.0
                sig = bool(np.isfinite(p) and p < ab)
                rows.append({
                    'SizeClass': sc,
                    'Comparison': f"{reference} vs {vname}",
                    'N': len(diffs_pooled),
                    'Median_diff': float(np.median(diffs_pooled)),
                    'Mean_diff': float(np.mean(diffs_pooled)),
                    'Wilcoxon_stat': stat,
                    'p_value': p,
                    'Significant_at_Bonferroni': sig,
                    'Cliffs_delta': cd,
                })
                lines.append(
                    f"{sc:<10} {rows[-1]['Comparison']:<24} "
                    f"{len(diffs_pooled):<4} "
                    f"{rows[-1]['Median_diff']:<14.4g} "
                    f"{rows[-1]['Mean_diff']:<14.4g} "
                    f"{p:<12.4g} {str(sig):<6} {cd:<10.3f}")
            lines.append("-" * 130)

        txt = "\n".join(lines)
        log(txt)
        with open(os.path.join(ABLATION_DIR,
                               'ablation_paired_wilcoxon_by_size_class.txt'),
                  'w') as f:
            f.write(txt)
        if rows:
            pd.DataFrame(rows).to_csv(
                os.path.join(ABLATION_DIR,
                             'ablation_paired_wilcoxon_by_size_class.csv'),
                index=False)
        return pd.DataFrame(rows)

    # ------------------------------------------------------------------
    # PART C — evaluation-mode comparison with duplicate collapsing
    # ------------------------------------------------------------------
    def run_evaluation_mode_comparison(self, instances, num_runs=10,
                                       modes=('deterministic','stochastic','dro')):
        log("\n" + "=" * 70)
        log("PART C — EVALUATION-MODE COMPARISON (det decode)")
        log("=" * 70)
        self.eval_rows = []
        for inst in instances:
            log(f"\n  Instance: {inst.name}  "
                f"(size-class {_size_class(inst.name)})")
            raw_det = {}
            for mode in modes:
                t0 = time.time()
                problem = LCCLRP(inst, evaluation_mode=mode)
                det_fronts = []
                for run in range(num_runs):
                    seed = self._get_seed(run)
                    np.random.seed(seed); random.seed(seed)
                    try:
                        algo = DROEMO(problem, self.base_cfg)
                        result = algo.run()
                        pop = result.get('population', [])
                    except Exception as e:
                        log(f"    [warn] mode={mode} run={run} failed: {e}")
                        pop = []
                    det = _decode_front_to_deterministic(problem, pop)
                    det_fronts.append(det)
                raw_det[mode] = det_fronts
                n_ok = sum(1 for d in det_fronts if len(d) > 0)
                log(f"    {mode:<14} {n_ok}/{num_runs} non-empty "
                    f"({time.time()-t0:.1f}s)")
            pooled = [d for fl in raw_det.values() for d in fl]
            ref, lo = _robust_reference_box(pooled)

            # Compute per-mode statistics.
            per_mode = {}
            for mode in modes:
                hvs, bcs, bco2s, bts = [], [], [], []
                for det in raw_det[mode]:
                    m = compute_metrics_3obj(det, ref=ref, lo=lo)
                    hvs.append(m['hypervolume']); bcs.append(m['best_cost'])
                    bco2s.append(m['best_emission']); bts.append(m['best_time'])
                if not hvs:
                    hvs=[0.0]; bcs=[np.nan]; bco2s=[np.nan]; bts=[np.nan]
                per_mode[mode] = {
                    'HV_mean': float(np.mean(hvs)),
                    'HV_std':  float(np.std(hvs)),
                    'cost':    float(np.nanmean(bcs)),
                    'co2':     float(np.nanmean(bco2s)),
                    'time':    float(np.nanmean(bts)),
                }

            # Collapse modes whose (HV, cost, CO2, time) match to 6 decimals.
            groups = []
            used = set()
            for m in modes:
                if m in used: continue
                g = [m]; used.add(m)
                key = per_mode[m]
                for m2 in modes:
                    if m2 in used: continue
                    k2 = per_mode[m2]
                    if (abs(key['HV_mean'] - k2['HV_mean']) < 1e-6
                            and abs(key['cost'] - k2['cost']) < 1e-6
                            and abs(key['co2'] - k2['co2']) < 1e-6
                            and abs(key['time'] - k2['time']) < 1e-6):
                        g.append(m2); used.add(m2)
                groups.append(g)

            for grp in groups:
                head = per_mode[grp[0]]
                label = "+".join(grp)
                log(f"    {label:<32} HV_det={head['HV_mean']:.4f} "
                    f"±{head['HV_std']:.4f}  cost={head['cost']:.6g}  "
                    f"CO2={head['co2']:.6g}")
                self.eval_rows.append({
                    'Instance': inst.name,
                    'SizeClass': _size_class(inst.name),
                    'Evaluation_Modes_Grouped': label,
                    'N_Modes_In_Group': len(grp),
                    'Hypervolume_mean': head['HV_mean'],
                    'Hypervolume_std':  head['HV_std'],
                    'Best_Cost_mean': head['cost'],
                    'Best_CO2_mean':  head['co2'],
                    'Best_Time_mean': head['time'],
                    'N_Runs': num_runs,
                })

        if self.eval_rows:
            pd.DataFrame(self.eval_rows).to_csv(
                os.path.join(ABLATION_DIR, 'evaluation_mode_comparison.csv'),
                index=False)
            log(f"\n  [ok] Saved evaluation_mode_comparison.csv "
                f"({len(self.eval_rows)} rows, duplicates collapsed)")
        return pd.DataFrame(self.eval_rows)


